    "content": "\\about\nUse CRMdata; \n#Our Main Database \n-- In Our Database we have total 3 Tables \n-- 1. Events table  \n-- 2. Campaigns table \n-- 3. Campaigns Spend table  \n-- We have data of Month Jan, Feb, and Mar.. \n-- We have 4 differents Campaigns that are running in org, which renew after every 5th day and cost occur to our Org\n-- We will check for Duplicates and clean the data if required\n -- We will create the resuable views, and do the per user analysis \n-- We will Analyse the Overall Campaign performance of our Campaigns\n-- We will do the Campaign Level Funnel Performance\n-- We will find the ROI and Cost per COnversion\n\nCREATE TABLE Events (\n  User_id VARCHAR(100),\n  Event_time DATETIME,\n  Event_type CHAR(100),\n  Campaign_id VARCHAR(50),\n  Channel CHAR(100)\n); #Created Table to capture Events data \nselect * from Events;\nCREATE TABLE Campaigns (\n  Campaign_id VARCHAR(100),\n  Campaign_name CHAR(100),\n  Channel CHAR(100),\n  Objective VARCHAR(50) \n  ); #Created table to capture Campaigns Data\nCREATE TABLE Campaign_Spend (\n  Campaign_id VARCHAR(100),\n  Spend_date DATE,\n  Cost INT4\n  ); #Created table for capturing Campaing Spend Data \nselect * from Campaign_Spend;\nCreate View Ordered_Events As \nSELECT \nUser_id, Event_type, Event_time, Campaign_id,Channel, \nROW_NUMBER() over(partition by user_id, Event_type order by Event_time ASC) \nas Row_Num #We have used this for eleminating Duplicate user with Same Event type, \n#whereever we will find Ruw_Num>1 this means that user has repeated for the same event type \nFROM Events;\n\n#Objectives we have fullfilled\n#Removes duplicate events\n#Keeps first occurrence per stage\n#Prevents fake conversion inflation\nSelect * from Ordered_Events\n#Lets check for Duplicates \nselect * from Ordered_Events\nwhere Row_Num>1;\n#No Data Displayed means no duplication is there \n#Creating this view to analyse the event type per user and also to seek information about campaign (from which the user has came in)\nCreate View User_Funnel as \nSelect User_id, Campaign_id, \nMax(case when Event_type=\"impression\" then 1 else 0 END) as Impression,\nMax(case when Event_type=\"click\" then 1 else 0 END) as Click,\nMax(case when Event_type=\"lead\" then 1 else 0 END ) as Lead_y,\nMax(case when Event_type=\"qualified\" then 1 else 0 end ) as Qualified,\nMax(case when Event_type=\"converted\" then 1 else 0 end) as Converted\nfrom Ordered_Events\nwhere Row_Num=1\nGROUP BY user_id, campaign_id;\n\nSelect * From User_Funnel;\n\n-- Funnel Count and Conversion Rates \nSelect Count(*) as Total_Users,\nsum(Impression) as Total_Impressions,\nsum(Click) as Clicked_Users,\nsum(Lead_y) as Total_Leads,\nsum(Qualified) as Qualified_Leads,\nsum(COnverted) as Conversions,\n ROUND(1.0 * SUM(converted) / COUNT(*), 2)*100 AS Overall_Conversion_Rate\n From User_Funnel;\n\n-- Campaign Level Funnel Performance \nSELECT \nCampaign_id, \ncount(*) as Users,\nsum(Converted) as Conversions,\nROUND(1.0 * SUM(converted) / COUNT(*), 2)*100 AS Conversion_Rate\nFROM User_Funnel\nGROUP BY Campaign_id;\n-- ROI & Cost per Conversion\nWITH campaign_conversions AS (\n  SELECT\n    campaign_id,\n    SUM(converted) AS conversions\n  FROM user_funnel\n  GROUP BY campaign_id\n),\ncampaign_cost AS (\n  SELECT\n    campaign_id,\n    SUM(cost) AS total_cost\n  FROM campaign_spend\n  GROUP BY campaign_id\n)\nSELECT\n  c.campaign_id,\n  total_cost,\n  conversions,\n  ROUND(total_cost / NULLIF(conversions, 0), 2) AS cost_per_conversion\nFROM campaign_cost c\nLEFT JOIN campaign_conversions cc\nON c.campaign_id = cc.campaign_id;\n\n\n",
